# ====== App ======
# URL the website is served at (used in Telegram WebApp button & links).
# Must be HTTPS for Telegram Mini App to work.
PUBLIC_URL=https://college.example.com

# Optional: separate URL for links sent inside Telegram. Use this if your
# public host is behind a tunnel that requires HTTP basic auth — embed the
# credentials like https://user:pass@host. Leave empty in production.
BOT_PUBLIC_URL=

# Random string used to sign admin session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# ====== Admin web panel ======
# Initial admin user created on first start (you can change the password later).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ====== Telegram bot ======
# Get from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram numeric user IDs who are allowed to
# manage content via the bot. Get yours from @userinfobot.
TELEGRAM_ADMIN_IDS=

# Optional: chat to forward new applications to (group / channel id, e.g. -1001234567890)
TELEGRAM_NOTIFY_CHAT_ID=

# Run mode: "polling" (recommended for VPS without HTTPS) or "webhook"
BOT_MODE=polling

# Used only when BOT_MODE=webhook. Must be HTTPS and publicly reachable.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# ====== Database ======
# Default is local SQLite. To use Postgres set:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./data/college.db
